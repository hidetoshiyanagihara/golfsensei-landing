# AI CEO COMMAND CENTER の設定例。`npm run setup` を実行すると .env.local が自動で作られます。
# .env.local は Git に入りません（リポジトリは公開なので、ここに書いた値は絶対にコミットしないこと）。

# ログイン用パスワード（12文字以上）
ADMIN_PASSWORD=
# セッション署名用のランダムな文字列（32文字以上）
SESSION_SECRET=
# パソコンで使うときの保存先（省略時は data/command-center.db）
# DB_PATH=./data/command-center.db

# スマホから使う本番（Netlify）では Turso を使う。Netlify の環境変数に設定する（ここには書かない）
# TURSO_DATABASE_URL=libsql://xxxx.turso.io
# TURSO_AUTH_TOKEN=

# --- PHASE 2 以降で使用（今は空のままでOK） ---
# Anthropic API キー。設定しても、管理画面の「自動実行」をONにするまでAIは動きません
# ANTHROPIC_API_KEY=
