{
  "name": "ai-ceo-command-center",
  "version": "0.1.0",
  "private": true,
  "description": "AI CEO PROJECT — AI CEO COMMAND CENTER（管理画面）",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev -p 3100",
