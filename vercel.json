{
  "git": {
    "deploymentEnabled": {
      "sns-log": false
    }
  },
  "redirects": [
    {
      "source": "/ai",
      "destination": "/ig-growth/output/prompts.html",
      "permanent": false
    },
    {
      "source": "/:src(x|instagram|youtube|linkedin|form)",
      "has": [
        {
          "type": "host",
          "value": "axionsales.vercel.app"
        }
      ],
      "destination": "/axion-sales.html?src=:src",
      "permanent": false
    },
    {
      "source": "/partner",
      "has": [
        {
          "type": "host",
          "value": "axionsales.vercel.app"
        }
      ],
      "destination": "/axion-partner.html",
      "permanent": false
    },
    {
      "source": "/apo",
      "has": [
        {
          "type": "host",
          "value": "axionsales.vercel.app"
        }
      ],
      "destination": "/axion-caller.html",
      "permanent": false
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "host",
          "value": "axionsales.vercel.app"
        }
      ],
      "destination": "/axion-privacy.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "axionsales.vercel.app"
        }
      ],
      "destination": "/axion-sales.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "copipe-ai.vercel.app"
        }
      ],
      "destination": "/ig-growth/output/prompts.html"
    }
  ]
}
