{
  "git": {
    "deploymentEnabled": {
      "sns-log": false
    }
  },
  "redirects": [
    {
      "source": "/:src(x|instagram|youtube|linkedin|form)",
      "has": [
        {
          "type": "host",
          "value": "axionsales.vercel.app"
        }
      ],
      "destination": "/axion-sales.html?src=:src",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "axionsales.vercel.app"
        }
      ],
      "destination": "/axion-sales.html",
      "permanent": false
    }
  ]
}
